# DukaanOS Environment Variables

# Server Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000

# MCP Server Configuration
MCP_PORT=4001
MCP_SECRET=dukaanos_secret_key_change_in_production
MCP_SERVER_URL=http://localhost:4001

# Supabase PostgreSQL Configuration (optional for local fallback; required for Supabase cloud)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Default Demo Business Configuration
DEFAULT_BUSINESS_ID=b0000000-0000-0000-0000-000000000001
DEFAULT_BUSINESS_NAME="Sharma General Store"

# Frontend Configuration
VITE_API_URL=http://localhost:4000

