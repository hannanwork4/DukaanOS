{
  "name": "dukaanos",
  "version": "1.0.0",
  "description": "DukaanOS - Voice-First Business Management Platform for Kirana Stores",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "mcp"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:mcp": "npm --prefix mcp run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:mcp\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:mcp": "npm --prefix mcp run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:mcp && npm run build:client",
    "start": "npm --prefix server start",
    "start:server": "npm --prefix server start",
    "start:mcp": "npm --prefix mcp start",
    "start:all": "concurrently \"npm --prefix server start\" \"npm --prefix mcp start\"",
    "test": "npm --prefix server run test"
  },
  "dependencies": {
    "concurrently": "^9.2.5"
  },
  "devDependencies": {
  }
}
